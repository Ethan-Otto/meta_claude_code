flowchart TD
    %% ==== Top row: Architect pipeline ====
    Architect(("Architect<br/>Asks"))
    MetaResearch["<b>Meta-Research</b><br/>What do we need to research?<br/>• Web<br/>• Our content<br/>• Policies<br/>• Drawings<br/>&nbsp;&nbsp;• Same plot drawings<br/>&nbsp;&nbsp;• Sync region drawings<br/>&nbsp;&nbsp;• Anti-drawings"]
    ConceptContext(["<b>Concept Context</b><br/>• Relevant Pages / Drawings<br/>• Relevant Policies<br/>• Plan Highlights UI"])

    %% ==== Scoping / Definition / Objectivification ====
    Scoping["<b>Scoping</b><br/>• What are we working with?<br/>• What do they want?<br/>• What questions do we need to answer?<br/>• Are we missing docs, definitions? Drawings?"]
    Definition(["<b>Definition</b><br/><b>Goals</b><br/>• Answers with questions<br/>• With evidence / citations"])
    Objectivification["<b>Objectivification</b><br/>• What is every piece of subcriteria we need to evaluate?<br/>• All possible edge cases?<br/>• What kind of test / not for best for each subcriteria?<br/>• How do we quantify success?"]

    %% ==== Tools Category ====
    Tools["<b>Tools Category</b><br/>• Classify Element<br/>• Find text<br/>• Scale check<br/>• Compare text<br/>• Geometric Eval / Measure<br/>• Segment element<br/>• Classify element system<br/>• BBox element"]

    %% ==== Objective Definitions / Augmentation ====
    ObjDef(["<b>Objective Definitions</b><br/><b>Subcriteria Tree</b><br/>• Full Citations<br/>• Drawing Highlights<br/>• Tool needed? Custom / General / Category<br/>• Sub Criteria Type:<br/>&nbsp;&nbsp;• Single page<br/>&nbsp;&nbsp;• Single page+<br/>&nbsp;&nbsp;• Multi page drawing<br/>&nbsp;&nbsp;• Multi page drawing+"])
    Augmentation["<b>Augmentation</b><br/>• Aug/gen drawings to make failing cases<br/>• Find negative drawings<br/>• Search additional train/test drawings"]

    %% ==== Manual Check ====
    ManualCheck["<b>↑ Manual Check Code</b><br/>• LLM Judge Similarity<br/>• Recommend Corrections<br/>• Reference Relevance"]

    %% ==== Implementation (state) ====
    Implementation(["<b>↓ Implementation</b><br/>• IP / Else Logic<br/>• LLM<br/>• VLLM<br/>• ML Model"])

    %% ==== Consistency Rate / Labeled Evals ====
    ConsistencyRate(["Consistency<br/>Rate"])
    LabeledEvals(["Labeled Evals"])

    %% ==== Results / Tool Registry ====
    ResultsReport["<b>Results Report</b>"]
    ToolRegistry["↓↑ Agent<br/>Tool / Registry"]

    %% ==== Connections ====
    Architect --> MetaResearch
    MetaResearch --> ConceptContext
    Architect --> Scoping
    ConceptContext --> Scoping
    Scoping --> Definition
    Definition --> Objectivification
    Tools --> Objectivification
    Objectivification --> ObjDef
    ObjDef --> Augmentation
    ObjDef --> Implementation
    Augmentation --> Implementation
    Implementation --> ManualCheck
    ManualCheck --> ObjDef
    ManualCheck --> Scoping
    Implementation --> ConsistencyRate
    Implementation --> LabeledEvals
    LabeledEvals --> ResultsReport
    ToolRegistry <--> Implementation

    %% Feedback loops (dashed)
    ConsistencyRate -.->|feedback| ObjDef
    LabeledEvals -.->|feedback| Augmentation

    %% ==== Styling ====
    classDef processBox fill:#fff,stroke:#555,stroke-width:2px
    classDef stateBox fill:#e3e3e3,stroke:#666,stroke-width:2px
    classDef metaBox fill:#fff,stroke:#555,stroke-width:2px
    classDef conceptBox fill:#e8f4e8,stroke:#2e7d32,stroke-width:2px
    classDef objBox fill:#fff8e1,stroke:#e65100,stroke-width:2px
