    classDef manualBox fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px
    classDef evalsBox fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px
    classDef resultsBox fill:#bbdefb,stroke:#1565c0,stroke-width:2px
    classDef registryBox fill:#d7ccc8,stroke:#4e342e,stroke-width:2px
    classDef architectBox fill:#fff3cd,stroke:#c9a800,stroke-width:3px

